# Python
venv/*
venv/
__pycache__/

# PyInstaller 빌드 산출물 (spec 자체는 추적)
build/
dist/
__pycache__/*
*.pyc
*/__init__.py
*/*/__init__.py
# src/__init__.py 는 앱 버전(__version__) 단일 소스라 추적해야 한다.
!src/__init__.py

# Environment
.env.local

# 사용자 로컬 설정 (앱이 생성, 머신별 값) — 추적 안 함
config.local.yaml

# 런타임 세션 상태 (DEV 모드면 프로젝트 루트에 생성됨) — 추적 안 함
last_session.yaml

# Logs
logs/*

# Test results
tests/vision/video/*
tests/*/*.txt
tests/*/*.html
tests/*/results.db
tests/stt/audio/*.wav
tests/*.txt
# STT 평가 산출물 (html/txt/db)
tests/stt/output/

# Development history
dev_history/*
dev_history

